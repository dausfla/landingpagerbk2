APP_NAME="RBK Studio x RBK Konstruksi"
APP_ENV=local
APP_DEBUG=true
APP_URL="http://localhost:8000"
APP_KEY="secret-app-key-change-in-production"
ADMIN_PATH="admin"

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rbk_db
DB_USER=root
DB_PASS=

# Initial Super Admin (For scripts/install.php)
INITIAL_ADMIN_EMAIL=admin@rancangbangunkreasi.id
INITIAL_ADMIN_NAME="Super Admin RBK"

# Security & IP Hashing Salt
IP_SALT="rbk-ip-hash-salt-2026"

# Mailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=rancangbangunkreasi.official@gmail.com
SMTP_FROM_NAME="RBK Official"
SMTP_TO_EMAIL=rancangbangunkreasi.official@gmail.com

# Telegram Bot Notification (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Turnstile (Optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
